#
#  Raise the Cortex-A9 to 1.2 GHz (VDD_ARM via the MAX8997, then CPU
#  dividers and APLL), early in DXE.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = Exynos441xCpuFreqDxe
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-2a441220c00f
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

  ENTRY_POINT    = CpuFreqDxeInitialize

[Sources.common]
  CpuFreqDxe.c

[Packages]
  MdePkg/MdePkg.dec
  ArmPkg/ArmPkg.dec
  Exynos441xPkg/Exynos441xPkg.dec

[LibraryClasses]
  DebugLib
  IoLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gExynosGpioProtocolGuid
  gExynosI2cProtocolGuid

[Depex]
  gExynosGpioProtocolGuid AND
  gExynosI2cProtocolGuid
