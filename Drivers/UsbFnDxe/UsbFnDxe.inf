#
#  Exynos4210 USB peripheral driver: EFI_USBFN_IO_PROTOCOL on the DWC2 USB
#  device controller (device mode only), interrupt driven.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#

[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = Exynos441xUsbFnDxe
  FILE_GUID      = 3c1f7e21-6a4d-4b0c-9c33-2a441220c008
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

  ENTRY_POINT    = UsbFnDxeInitialize

[Sources.common]
  UsbFnDxe.h
  UsbFnDxe.c
  Dwc2.c
  Board.c
  SelfTest.c

[Packages]
  MdePkg/MdePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  ArmPkg/ArmPkg.dec
  Exynos441xPkg/Exynos441xPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  IoLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiUsbFunctionIoProtocolGuid
  gHardwareInterruptProtocolGuid
  gExynosClockProtocolGuid
  gExynosGpioProtocolGuid
  gExynosI2cProtocolGuid

[Depex]
  gHardwareInterruptProtocolGuid AND
  gExynosClockProtocolGuid AND
  gExynosGpioProtocolGuid AND
  gExynosI2cProtocolGuid
